{
  "name": "approval-mcp-wrapper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test scripts/*.test.mjs && vitest run",
    "typecheck": "tsc -b",
    "build": "tsc -b && npm run build -w @approval-mcp/web",
    "audit:deps": "node scripts/dependency-report.mjs && npm audit --omit=dev --audit-level=high",
    "verify:language": "node scripts/verify-language.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run audit:deps && npm run verify:language"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.1",
    "fastify": "5.12.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
